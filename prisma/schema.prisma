  parentTicket          SupportTicket?    @relation("ParentTicket", fields: [parentTicketId], references: [id])
  mergedTicket          SupportTicket?    @relation("MergedTicket", fields: [mergedTicketId], references: [id])
  duplicateOfTicket     SupportTicket?    @relation("DuplicateTicket", fields: [duplicateOfTicketId], references: [id])

