  updatedAt             DateTime          @updatedAt
  resolvedAt            DateTime?
  closedAt              DateTime?
  reopenedAt            DateTime?
  reopenedCount         Int               @default(0)

  // Relations
  user                  User              @relation("CustomerTickets", fields: [userId], references: [id])
  assignedAgent         SupportAgent?     @relation("AssignedTickets", fields: [assignedTo], references: [id])
  assignedByAgent       SupportAgent?     @relation("Assigner", fields: [assignedBy], references: [id])
  escalatedToAgent      SupportAgent?     @relation("EscalatedTo", fields: [escalatedTo], references: [id])
  escalatedByAgent      SupportAgent?     @relation("EscalatedBy", fields: [escalatedBy], references: [id])
