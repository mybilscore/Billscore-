// ============================================================
// VENDOR MANAGEMENT TABLES
// ============================================================

model Vendor {
  id                    String          @id @default(uuid())
  name                  String          @unique
  code                  String          @unique
  type                  VtuVendor
  apiBaseUrl            String
  authType              VendorAuthType  @default(API_KEY)
  authConfig            Json?
  status                VendorStatus    @default(ACTIVE)
  priority              Int             @default(1)
  successRate           Decimal         @default(0)
  avgResponseTime       Int             @default(0)
  failureCount          Int             @default(0)
  consecutiveFailures   Int             @default(0)
  lastCheckAt           DateTime?       @default(now())
  lastSuccessAt         DateTime?
  lastFailureAt         DateTime?
  metadata              Json?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Relations
  services              VendorService[]
  endpoints             VendorApiEndpoint[]
  transformers          VendorTransformer[]
  failoverRules         VendorFailoverRule[]
  circuitBreakers       CircuitBreaker[]
  healthChecks          VendorHealthCheck[]
  dailyMetrics          VendorDailyMetric[]
  transactionAttempts   VtuTransactionAttempt[]
  productProviders      ProductProvider[]
  vendorSelectionLogs   VendorSelectionLog[]    @relation("SelectedVendorLog")
  
  selectedTransactions  VtuTransaction[]        @relation("SelectedVendor")
  vendorTransactions    VtuTransaction[]        @relation("VendorTransactions")

  @@map("vendors")
}

model VendorService {
  id                    String          @id @default(uuid())
  vendorId              String
  serviceType           VtuType
  isActive              Boolean         @default(true)
  priority              Int             @default(1)
  basePrice             Decimal?
  markup                Decimal         @default(0)
  minAmount             Decimal?
  maxAmount             Decimal?
  metadata              Json?

  // Relations
  vendor                Vendor          @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, serviceType])
  @@index([serviceType])
  @@index([isActive])
  @@map("vendor_services")
}

model VendorApiEndpoint {
  id                    String          @id @default(uuid())
  vendorId              String
  serviceType           VtuType
  endpoint              String
  method                String          @default("POST")
  requestMapping        Json?
  responseMapping       Json?
  errorMapping          Json?
  timeoutMs             Int             @default(30000)
  retryableErrors       Json?

  // Relations
  vendor                Vendor          @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, serviceType])
  @@map("vendor_api_endpoints")
}

model VendorTransformer {
  id                    String          @id @default(uuid())
  vendorId              String
  serviceType           VtuType
  transformType         String
  script                String?
  mapping               Json
  isActive              Boolean         @default(true)

  // Relations
  vendor                Vendor          @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, serviceType, transformType])
  @@map("vendor_transformers")
}

model VendorFailoverRule {
  id                    String          @id @default(uuid())
  vendorId              String
  serviceType           VtuType?
  failureThreshold      Int             @default(3)
  errorRateThreshold    Decimal         @default(0.1)
  timeWindowMs          Int             @default(60000)
  maxRetries            Int             @default(3)
  retryDelayMs          Int             @default(1000)
  backoffMultiplier     Decimal         @default(2.0)
  fallbackVendorId      String?
  fallbackAfterMs       Int             @default(5000)
  circuitBreakerEnabled Boolean         @default(true)
  circuitBreakerThreshold Int           @default(5)
  circuitBreakerTimeoutMs Int           @default(60000)

  // Relations
  vendor                Vendor          @relation(fields: [vendorId], references: [id])

  @@map("vendor_failover_rules")
}

model CircuitBreaker {
  id                    String                @id @default(uuid())
  vendorId              String
  serviceType           VtuType?
  state                 CircuitBreakerState   @default(CLOSED)
  failureCount          Int                   @default(0)
  successCount          Int                   @default(0)
  lastFailureAt         DateTime?
  lastSuccessAt         DateTime?
  openedAt              DateTime?
  resetTimeoutMs        Int                   @default(60000)

  // Relations
  vendor                Vendor                @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, serviceType])
  @@index([state])
  @@map("circuit_breakers")
}

model VendorHealthCheck {
  id                    String          @id @default(uuid())
  vendorId              String
  serviceType           VtuType?
  status                VendorStatus
  responseTime          Int
  isSuccess             Boolean
  errorMessage          String?
  uptimePercentage      Decimal         @default(100)
  errorRate             Decimal         @default(0)
  avgResponseTime       Int             @default(0)
  minResponseTime       Int             @default(0)
  maxResponseTime       Int             @default(0)
  requestCount          Int             @default(0)
  successCount          Int             @default(0)
  failureCount          Int             @default(0)
  checkedAt             DateTime        @default(now())
  metadata              Json?

  // Relations
  vendor                Vendor          @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([checkedAt])
  @@index([serviceType])
  @@map("vendor_health_checks")
}

model VendorDailyMetric {
  id                    String          @id @default(uuid())
  vendorId              String
