  // Relations
  vendor                Vendor          @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, date, serviceType])
  @@index([vendorId])
  @@index([date])
  @@map("vendor_daily_metrics")
}

model VendorSelectionLog {
