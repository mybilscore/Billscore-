  RATE_LIMIT_EXCEEDED
  BRUTE_FORCE_ATTEMPT
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  PERMISSION_CHANGED
  ROLE_CHANGED
  API_ACCESS
  SESSION_CREATED
  SESSION_TERMINATED
  DEVICE_REGISTERED
  DEVICE_UNREGISTERED
}

enum BlockReason {
  BRUTE_FORCE
  SUSPICIOUS_ACTIVITY
  ADMIN_ACTION
  POLICY_VIOLATION
  FRAUD_SUSPICION
  MULTIPLE_FAILURES
  IP_BLOCKED
  USER_REQUEST
  SYSTEM_AUTO
}

// ============================================================
// SECURITY TABLES (FIXED)
// ============================================================

model RegistrationAttempt {
  id            String    @id @default(uuid())
  email         String
  ipAddress     String
  userAgent     String?
  attempts      Int       @default(1)
  firstAttempt  DateTime  @default(now())
  lastAttempt   DateTime  @updatedAt
  blockedUntil  DateTime?
  blockReason   BlockReason?
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  securityEvents SecurityEvent[]

  @@unique([email, ipAddress])
  @@index([email])
  @@index([ipAddress])
  @@index([blockedUntil])
  @@map("registration_attempts")
}

model AuditLog {
  id            String    @id @default(uuid())
  userId        String?
  action        String
  entityType    String?
  entityId      String?
  oldValues     Json?
  newValues     Json?
  ipAddress     String?
  userAgent     String?
  channel       ChannelType?
  metadata      Json?
  timestamp     DateTime  @default(now())
  createdAt     DateTime  @default(now())

  // Relations - FIXED: Removed direct securityEvents relation
  user          User?     @relation("UserAudit", fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([timestamp])
  @@index([createdAt])
  @@map("audit_logs")
}

model RateLimit {
  id            String    @id @default(uuid())
  key           String    @unique
  requests      Int       @default(0)
  windowStart   DateTime  @default(now())
  windowEnd     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  securityEvents SecurityEvent[]

  @@index([key])
  @@index([windowEnd])
  @@map("rate_limits")
}

model SecurityEvent {
  id            String              @id @default(uuid())
  userId        String?
  eventType     SecurityEventType
  ipAddress     String
  userAgent     String?
  sessionId     String?             // Single definition
  location      String?
  deviceId      String?
  details       Json?
  isBlocked     Boolean             @default(false)
  blockReason   BlockReason?
  blockedUntil  DateTime?
  isResolved    Boolean             @default(false)
  resolvedAt    DateTime?
  resolvedBy    String?
  resolutionNotes String?
  createdAt     DateTime            @default(now())

  // Relations
  user          User?               @relation("UserSecurityEvents", fields: [userId], references: [id])
  
  registrationAttemptId String?
  registrationAttempt RegistrationAttempt? @relation(fields: [registrationAttemptId], references: [id])
  
  rateLimitId   String?
  rateLimit     RateLimit?          @relation(fields: [rateLimitId], references: [id])
  
  session       Session?            @relation(fields: [sessionId], references: [id])
  
  blockedIPId   String?
  blockedIP     BlockedIP?          @relation(fields: [blockedIPId], references: [id])

  @@index([userId])
  @@index([eventType])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([isBlocked])
  @@map("security_events")
}

model BlockedIP {
  id            String    @id @default(uuid())
  ipAddress     String    @unique
  reason        String?
  blockedBy     String?
  blockedAt     DateTime  @default(now())
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations - FIXED: Added opposite relation
  securityEvents SecurityEvent[]

  @@index([ipAddress])
  @@index([isActive])
  @@index([expiresAt])
  @@map("blocked_ips")
}

model SecurityAlert {
  id            String    @id @default(uuid())
  type          String
  severity      String    // CRITICAL, HIGH, MEDIUM, LOW
  message       String
  details       Json?
  source        String?   // IP, User, System
  sourceId      String?
  isResolved    Boolean   @default(false)
  resolvedAt    DateTime?
  resolvedBy    String?
  notes         String?
  userId        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  user          User?     @relation(fields: [userId], references: [id])

  @@index([severity])
  @@index([isResolved])
  @@index([createdAt])
  @@map("security_alerts")
}

// ============================================================
// CORE TABLES (UPDATED WITH SECURITY RELATIONS)
// ============================================================

model User {
  id                    String          @id @default(uuid())
  email                 String?         @unique
  username              String?         @unique
  passwordHash          String?
  phone                 String          @unique
  pinHash               String?
  fullName              String
  role                  UserRole        @default(END_USER)
  walletBalance         Decimal         @default(0)
  hasWallet             Boolean         @default(false)
  isVerified            Boolean         @default(false)
  kycStatus             KYCStatus       @default(PENDING)
  kycData               Json?
  isWalletFrozen        Boolean         @default(false)
  walletFrozenAt        DateTime?
  walletFrozenReason    String?
  referralCode          String?         @unique
  referredBy            String?
  preferredChannel      ChannelType?
  preferredLanguage     Language        @default(EN)
  pinAttempts           Int             @default(0)
  pinLockedUntil        DateTime?
  lastLoginAt           DateTime?

  // Security fields
  isLocked              Boolean         @default(false)
  lockedAt              DateTime?
  lockedReason          String?
  loginAttempts         Int             @default(0)
  lastLoginIP           String?
  lastLoginUserAgent    String?
  twoFactorEnabled      Boolean         @default(false)
  twoFactorSecret       String?
  lastPasswordChangeAt  DateTime?

  // Developer fields
  isDeveloper           Boolean         @default(false)
  developerAccountType  DeveloperAccountType? @default(BASIC)
  developerStatus       DeveloperStatus? @default(PENDING)
  companyName           String?
  developerMonthlyVolume Decimal       @default(0)
  developerCustomPricing Json?

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Relations
  channels              Channel[]
  ussdSessions          UssdSession[]
  wallet                Wallet?
  walletTransactions    WalletTransaction[]
  vtuTransactions       VtuTransaction[]
  subscriptions         Subscription[]
  preOrders             PreOrder[]
  tokenVault            TokenVault[]
  loans                 RetailerLoan[]
  repayments            Repayment[]
  sentTransfers         WalletTransfer[]  @relation("Sender")
  receivedTransfers     WalletTransfer[]  @relation("Receiver")
  notifications         UserNotification[]
  supportTickets        SupportTicket[]   @relation("CustomerTickets")
  supportReplies        SupportReply[]
  knowledgeBaseVotes    KnowledgeBaseVote[]
  supportSatisfaction   SupportSatisfaction[]
  auditLogs             AuditLog[]        @relation("UserAudit")
  developer             Developer?
  apiKeys               ApiKey[]
  qrCodes               QRCode[]
  qrPayments            QRPayment[]
  referredReferrals     Referral[]        @relation("Referrer")
  refereeReferrals      Referral[]        @relation("Referee")
  sessions              Session[]
  loanNotifications     LoanNotification[]
  ussdLogs              UssdLog[]
  supportAgent          SupportAgent?
  chatSessions          SupportChatSession[]
  knowledgeBaseAuthor   KnowledgeBase[]   @relation("Author")
  knowledgeBaseReviewer KnowledgeBase[]   @relation("Reviewer")
  knowledgeBaseRevisions KnowledgeBaseRevision[]
  knowledgeBaseAttachments KnowledgeBaseAttachment[]
  supportReplyReactions SupportReplyReaction[]
  uploaderAttachments   SupportAttachment[] @relation("Uploader")
  supportAutomationExecutions SupportAutomationExecution[]

  savedMeters           SavedMeter[]
  savedDecoders         SavedDecoder[]

  // Customer management relations
  customers             Customer[]
  customerTransactions  CustomerTransaction[]
  customerNotes         CustomerNote[]
  customerCommunications CustomerCommunication[]
  customerSegments      CustomerSegment[]
  customerDiscounts     CustomerDiscount[]
  commissionSettings    CommissionSetting[]
  customerAnalytics     CustomerAnalytics[]

  // Security relations - FIXED: Removed blockedIPs direct relation
  // Users are linked to BlockedIP through SecurityEvents
  securityEvents        SecurityEvent[]    @relation("UserSecurityEvents")
  securityAlerts        SecurityAlert[]

  @@map("users")
}

// ============================================================
// REMAINING MODELS (UNCHANGED)
// ============================================================

model Channel {
  id                String        @id @default(uuid())
  userId            String
  channelType       ChannelType
  channelIdentifier String        @unique
  channelUsername   String?
  isVerified        Boolean       @default(false)
  linkedAt          DateTime      @default(now())
  lastSeen          DateTime      @default(now())
  simCarrier        String?
  simExpiry         DateTime?
  metadata          Json?

  // Relations
  user              User          @relation(fields: [userId], references: [id])

  @@unique([userId, channelType])
  @@map("channels")
}

// ============================================================
// WALLET TABLES
// ============================================================

model Wallet {
  id                String          @id @default(uuid())
  userId            String          @unique
  accountNumber     String          @unique
  bankName          String          @default("PALMPAY")
  accountName       String
  walletBalance     Decimal         @default(0)
  ledgerBalance     Decimal         @default(0)
  currency          String          @default("NGN")
  isActive          Boolean         @default(true)
  isFrozen          Boolean         @default(false)
  frozenAt          DateTime?
  frozenReason      String?
  kycLevel          Int             @default(1)
  dailyLimit        Decimal         @default(0)
  monthlyLimit      Decimal         @default(0)
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  user              User            @relation(fields: [userId], references: [id])
  transactions      WalletTransaction[]
  fundingHistory    WalletFunding[]

  @@index([userId])
  @@index([accountNumber])
  @@map("wallets")
}

model WalletFunding {
  id                String                @id @default(uuid())
  walletId          String
  amount            Decimal
  reference         String                @unique
  provider          String                @default("PALMPAY")
  providerReference String?
  status            WalletFundingStatus   @default(PENDING)
  metadata          Json?
  createdAt         DateTime              @default(now())
  completedAt       DateTime?

  // Relations
  wallet            Wallet                @relation(fields: [walletId], references: [id])
  walletTransaction WalletTransaction?    @relation("WalletFundingTransaction")

  @@index([walletId])
  @@index([reference])
  @@index([status])
  @@map("wallet_fundings")
}

model WalletTransaction {
  id                String                @id @default(uuid())
  walletId          String
  userId            String
  type              WalletTransactionType
  amount            Decimal
  balanceBefore     Decimal
  balanceAfter      Decimal
  reference         String                @unique
  description       String
  status            TransactionStatus     @default(PENDING)
  category          WalletCategory?
  channel           ChannelType?
  metadata          Json?
  createdAt         DateTime              @default(now())

  // Relations
  wallet            Wallet                @relation(fields: [walletId], references: [id])
  user              User                  @relation(fields: [userId], references: [id])
  
  vtuTransactionId  String?               @unique
  vtuTransaction    VtuTransaction?       @relation("WalletToVtu", fields: [vtuTransactionId], references: [id])
  
  repaymentId       String?               @unique
  loanRepayment     Repayment?            @relation("WalletToRepayment", fields: [repaymentId], references: [id])
  
  loanDisbursementId String?              @unique
  loanDisbursement  RetailerLoan?         @relation("WalletToLoan", fields: [loanDisbursementId], references: [id])
  
  qrPaymentId       String?               @unique
  qrPayment         QRPayment?            @relation("WalletToQR", fields: [qrPaymentId], references: [id])
  
  fundingId         String?               @unique
  walletFunding     WalletFunding?        @relation("WalletFundingTransaction", fields: [fundingId], references: [id])
  
  debitTransferId   String?               @unique
  debitTransfer     WalletTransfer?       @relation("DebitTransfer", fields: [debitTransferId], references: [id])
  
  creditTransferId  String?               @unique
  creditTransfer    WalletTransfer?       @relation("CreditTransfer", fields: [creditTransferId], references: [id])

  @@index([walletId])
  @@index([userId])
  @@index([reference])
  @@index([createdAt])
  @@index([category])
  @@map("wallet_transactions")
}

model WalletTransfer {
  id              String        @id @default(uuid())
  senderId        String
  receiverId      String
  amount          Decimal
  fee             Decimal       @default(0)
  totalDebited    Decimal
  reference       String        @unique
  description     String?
  status          TransactionStatus @default(PENDING)
  channel         ChannelType?
  createdAt       DateTime      @default(now())
  completedAt     DateTime?

  // Relations
  sender          User          @relation("Sender", fields: [senderId], references: [id])
  receiver        User          @relation("Receiver", fields: [receiverId], references: [id])

  debitTransaction WalletTransaction? @relation("DebitTransfer")
  creditTransaction WalletTransaction? @relation("CreditTransfer")

  @@index([senderId])
  @@index([receiverId])
  @@index([reference])
  @@map("wallet_transfers")
}

// ============================================================
// CUSTOMER MANAGEMENT TABLES
// ============================================================

model Customer {
  id                    String          @id @default(uuid())
  userId                String
  phone                 String
  email                 String?
  fullName              String?
  address               String?
  city                  String?
  state                 String?
  country               String          @default("Nigeria")
  dateOfBirth           DateTime?
  gender                String?
  customerType          CustomerType    @default(REGULAR)
  isFavorite            Boolean         @default(false)
  isActive              Boolean         @default(true)
  tags                  Json
  notes                 String?
  totalTransactions     Int             @default(0)
  totalSpent            Decimal         @default(0)
  totalCommissionEarned Decimal         @default(0)
  lastTransactionAt     DateTime?
  firstTransactionAt    DateTime?
  lastInteractionAt     DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Relations
  user                  User            @relation(fields: [userId], references: [id])
  transactions          CustomerTransaction[]
  communications        CustomerCommunication[]
  notesHistory          CustomerNote[]
  devices               CustomerDevice[]
  segmentMembers        CustomerSegmentMember[]
  loyaltyPoints         CustomerLoyaltyPoint?
  loyaltyTransactions   CustomerLoyaltyTransaction[]
  discounts             CustomerDiscount[]

  @@unique([userId, phone])
  @@index([userId])
  @@index([phone])
  @@index([isFavorite])
  @@index([createdAt])
  @@index([lastTransactionAt])
  @@map("customers")
}

model CustomerTransaction {
  id                    String          @id @default(uuid())
  customerId            String
  userId                String
  vtuTransactionId      String?         @unique
  transactionType       VtuType
  amount                Decimal
  serviceFee            Decimal         @default(0)
  totalAmount           Decimal
  product               String
  phoneNumber           String?
  meterNumber           String?
  network               NetworkProvider?
  planName              String?
  customerPhoneProvided String?
  customerNameProvided  String?
  commissionAmount      Decimal         @default(0)
  commissionRate        Decimal         @default(0)
  commissionPaid        Boolean         @default(false)
  commissionPaidAt      DateTime?
  status                TransactionStatus @default(SUCCESS)
  notes                 String?
  metadata              Json?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Relations
  customer              Customer        @relation(fields: [customerId], references: [id])
  user                  User            @relation(fields: [userId], references: [id])
  vtuTransaction        VtuTransaction? @relation("VtuToCustomer", fields: [vtuTransactionId], references: [id])

  @@index([customerId])
  @@index([userId])
  @@index([createdAt])
  @@index([transactionType])
  @@index([status])
  @@map("customer_transactions")
}

model CustomerNote {
  id                    String          @id @default(uuid())
  customerId            String
  userId                String
  note                  String
  type                  String          @default("GENERAL")
