// ============================================================
// VTU TRANSACTIONS
// ============================================================

model VtuTransaction {
  id                    String                @id @default(uuid())
  userId                String
  transactionType       VtuType
  product               String
  amount                Decimal
  serviceFee            Decimal               @default(0)
  totalDebited          Decimal

  selectedVendorId      String?
  vendorPriorityUsed    Int?
  fallbackAttempts      Int                   @default(0)
  failedVendors         Json?

  vendor                VtuVendor?
  vendorReference       String?
  status                TransactionStatus     @default(PENDING)
  retryCount            Int                   @default(0)
  maxRetries            Int                   @default(3)

  meterNumber           String?
  meterType             MeterType?
  meterName             String?
  phoneNumber           String?
  network               NetworkProvider?
  networkPlan           String?
  token                 String?
  tokenValidUntil       DateTime?
  scheduledFor          DateTime?
  deliveredAt           DateTime?
  isBulkPurchase        Boolean               @default(false)
  bulkQuantity          Int?
  channel               ChannelType?
  apiKeyId              String?
  qrPaymentId           String?               @unique
  metadata              Json?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  // Relations
  user                  User                  @relation(fields: [userId], references: [id])
  
  selectedVendor        Vendor?               @relation("SelectedVendor", fields: [selectedVendorId], references: [id])
  
  walletTransactionId   String?               @unique
  walletTransaction     WalletTransaction?    @relation("WalletToVtu")
  
  subscriptionId        String?
  subscription          Subscription?         @relation(fields: [subscriptionId], references: [id])
  
  qrPayment             QRPayment?            @relation("QRToVtu")
  
  vendorId              String?
  vendorInfo            Vendor?               @relation("VendorTransactions", fields: [vendorId], references: [id])
  
  preOrder              PreOrder?
  tokenVault            TokenVault?
  apiKey                DeveloperApiKey?      @relation(fields: [apiKeyId], references: [id])
  attempts              VtuTransactionAttempt[]
  
  customerTransaction   CustomerTransaction?  @relation("VtuToCustomer")

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([selectedVendorId])
  @@map("vtu_transactions")
}

model VtuTransactionAttempt {
